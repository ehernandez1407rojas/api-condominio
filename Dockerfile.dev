# IMAGEN BASE DE python LIGERA
FROM python:3.11-slim

# DEFINIR VARIABLES DE ENTORNO
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# ESTABLECER EL DIRECTORIO DE TRABAJO EN EL CONTENEDOR
WORKDIR /codigo

# INSTALAR LAS DEPENDENCIAS DEL PROYECTO AL CONTENEDOR EL PUNTO SIGNIFICA EL DIRECTORIO RAIZ DEL CONTENEDOR
# Y DADO QUE TENEMOS REQUERIMIENTOS POR AMBIENTE TOMAMOS EL LOCAL
COPY requerimientos/ requerimientos/

RUN pip install --upgrade pip

RUN pip install \
    --no-cache-dir \
    -r requerimientos/local.txt



# COPIAR EL PROYECTO AL CONTENEDOR
COPY . .

EXPOSE 8000